<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_access_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Ombre néo-brutaliste -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_shadow" />

    <!-- Conteneur Principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Ligne du haut: Lecture en cours + Contrôles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Artwork -->
            <ImageView
                android:id="@+id/quick_widget_artwork"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_play_button"
                android:contentDescription="Milo"
                android:padding="10dp"
                android:src="@drawable/ic_notification" />

            <!-- Infos -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/quick_widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="Milo"
                    android:textColor="@color/milo_cream"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quick_widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Lecteur local"
                    android:textColor="@color/milo_cream"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Contrôles -->
            <ImageButton
                android:id="@+id/quick_widget_skip_previous"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Précédent"
                android:src="@android:drawable/ic_media_previous" />

            <ImageButton
                android:id="@+id/quick_widget_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_play_button"
                android:contentDescription="Lecture"
                android:padding="8dp"
                android:src="@android:drawable/ic_media_play" />

            <ImageButton
                android:id="@+id/quick_widget_skip_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Suivant"
                android:src="@android:drawable/ic_media_next" />
        </LinearLayout>

        <!-- Séparateur -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:alpha="0.3"
            android:background="@color/milo_cream" />

        <!-- Raccourcis -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Bibliothèque -->
            <LinearLayout
                android:id="@+id/quick_widget_library"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Bibliothèque"
                    android:src="@android:drawable/ic_menu_gallery" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Musiques"
                    android:textColor="@color/milo_cream"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Radios -->
            <LinearLayout
                android:id="@+id/quick_widget_radio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Radio"
                    android:src="@android:drawable/ic_btn_speak_now" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Radio"
                    android:textColor="@color/milo_cream"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Shuffle/Aléatoire -->
            <LinearLayout
                android:id="@+id/quick_widget_shuffle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Aléatoire"
                    android:src="@android:drawable/ic_menu_rotate" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Aléatoire"
                    android:textColor="@color/milo_cream"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Favoris -->
            <LinearLayout
                android:id="@+id/quick_widget_favorites"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Favoris"
                    android:src="@android:drawable/btn_star_big_on" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Favoris"
                    android:textColor="@color/milo_cream"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
